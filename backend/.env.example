PORT=5000
MONGODB_URI=mongodb://localhost:27017/buildtrack
JWT_SECRET=super_secret_buildtrack_jsonwebtoken_key_2026
NODE_ENV=development

# Real Gmail SMTP Verification Configuration (Optional)
# For Gmail, set EMAIL_HOST=smtp.gmail.com and EMAIL_PORT=587.
# EMAIL_PASS must be a Google App Password (2-step verification must be enabled).
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587